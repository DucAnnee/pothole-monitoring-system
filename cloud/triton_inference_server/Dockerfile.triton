# syntax=docker/dockerfile:1
FROM nvcr.io/nvidia/tritonserver:24.12-py3

# Install SAM3 dependencies from requirements file (covers all transitive deps).
# pip cache mount persists downloaded wheels across build attempts (torch is huge);
# Aliyun mirror is much faster than default PyPI from the VN region.
COPY sam3_finetune/requirements.txt /tmp/sam3_requirements.txt
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --retries 10 --timeout 120 \
      -i https://mirrors.aliyun.com/pypi/simple/ --trusted-host mirrors.aliyun.com \
      -r /tmp/sam3_requirements.txt && \
    pip install --retries 10 --timeout 120 \
      -i https://mirrors.aliyun.com/pypi/simple/ --trusted-host mirrors.aliyun.com \
      "minio>=7.2" "opencv-python-headless>=4.8"

# Copy SAM3 local package and LoRA implementation into image
COPY sam3_finetune/sam3 /opt/sam3
COPY sam3_finetune/lora_layers.py /opt/lora_layers.py

ENV PYTHONPATH=/opt:$PYTHONPATH
