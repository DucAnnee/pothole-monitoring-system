{
  "title": "Pipeline Latency",
  "uid": "pothole-latency",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Total pipeline latency (ms)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [{ "expr": "pothole_pipeline_total_latency_ms", "refId": "A" }]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Per-stage p95 (ms)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(pothole_pipeline_stage_latency_ms_bucket[5m])) by (le, stage))", "refId": "A" }]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Kafka consumer lag",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 8 },
      "targets": [{ "expr": "sum(kafka_consumergroup_lag) by (consumergroup)", "refId": "A" }]
    }
  ]
}
