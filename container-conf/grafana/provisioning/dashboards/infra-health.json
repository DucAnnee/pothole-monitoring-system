{
  "title": "Infra Health",
  "uid": "pothole-infra",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Triton inference success/s",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [{ "expr": "rate(nv_inference_request_success[5m])", "refId": "A" }]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Container CPU (cores)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [{ "expr": "sum(rate(container_cpu_usage_seconds_total{name=~\".+\"}[5m])) by (name)", "refId": "A" }]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Redis memory bytes",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [{ "expr": "redis_memory_used_bytes", "refId": "A" }]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "PostGIS connections",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [{ "expr": "pg_stat_database_numbackends{datname=\"postgis_serving\"}", "refId": "A" }]
    }
  ]
}
